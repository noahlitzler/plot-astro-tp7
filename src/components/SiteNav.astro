---
const { active = "" } = Astro.props;
---

<aside class="sidebar">
  <a href="/" class="brand">
    <span>Explorer</span>
  </a>

  <div class="sidebar-line"></div>

  <nav>
    <p class="nav-label">DATASETS</p>

    <a
      href="/penguins/"
      class:list={{ active: active === "penguins" }}
      class="nav-item"
    >
      <span class="nav-number">01</span>
      <span>Penguins</span>
    </a>

    <a
      href="/cars-exploration/"
      class:list={{ active: active === "cars" }}
      class="nav-item"
    >
      <span class="nav-number">02</span>
      <span>Cars</span>
    </a>

    <a
      href="/diamonds-exploration/"
      class:list={{ active: active === "diamonds" }}
      class="nav-item"
    >
      <span class="nav-number">03</span>
      <span>Diamonds</span>
    </a>

    <div class="sidebar-line"></div>

    <p class="nav-label">ROUTES</p>

    <a
      href="/rendu-dynamique/"
      class:list={{ active: active === "dynamique" }}
      class="nav-item"
    >
      <span class="nav-number">04</span>
      <span>Rendu dynamique</span>
    </a>

    <a
      href="/rendu-statique/"
      class:list={{ active: active === "statique" }}
      class="nav-item"
    >
      <span class="nav-number">05</span>
      <span>Rendu statique</span>
    </a>
  </nav>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 228px;
    height: 100vh;
    padding: 38px 20px;
    box-sizing: border-box;
    background: #111111;
    color: #ffffff;
    z-index: 20;
  }

  .brand {
    display: flex;
    align-items: center;
    padding: 0 9px;
    color: #ffffff;
    text-decoration: none;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .sidebar-line {
    height: 1px;
    margin: 32px 9px 34px;
    background: #303030;
  }

  .nav-label {
    margin: 0 9px 14px;
    color: #777777;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 42px;
    padding: 0 9px;
    border-radius: 4px;
    color: #8f8f8f;
    text-decoration: none;
    font-size: 14px;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .nav-item:hover {
    color: #ffffff;
    background: #1a1a1a;
  }

  .nav-item.active {
    color: #ffffff;
    background: #1c1c1c;
  }

  .nav-number {
    width: 18px;
    color: #666666;
    font-size: 10px;
  }

  .nav-item.active .nav-number {
    color: #ffffff;
  }

  @media (max-width: 800px) {
    .sidebar {
      position: relative;
      width: 100%;
      height: auto;
      padding: 20px;
    }

    .sidebar-line {
      margin: 20px 9px;
    }

    .nav {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>