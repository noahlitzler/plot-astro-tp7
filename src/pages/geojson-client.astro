---
import Layout from "../layouts/Layout.astro";
import populationMain from "../assets/populationMain.json";
import departements from "../assets/departements.geojson.json";

const listePeriode = [...new Set(populationMain.map((d) => d.Période))].sort((a, b) => b - a);
const listeSexe = [...new Set(populationMain.map((d) => d.Sexe))];
const listeAge = [...new Set(populationMain.map((d) => d["Âge"].trim()))];
---

<Layout title="Population par département" active="geojson">
  <main class="page">
    <header class="intro">
      <p class="eyebrow">DONNÉES · TERRITOIRE</p>
      <h1>La population française</h1>
      <p class="description">
        Explorez la répartition de la population par département en faisant
        varier la période, le sexe et l'âge.
      </p>
    </header>

    <section class="panel" aria-labelledby="filters-title">
      <h2 id="filters-title">Paramètres d'affichage</h2>

      <div class="filters">
        <label>
          <span>Période</span>
          <select id="periode">
            {listePeriode.map((p, i) => (
              <option value={p} selected={i === 0}>{p}</option>
            ))}
          </select>
        </label>

        <label>
          <span>Sexe</span>
          <select id="sexe">
            {listeSexe.map((s, i) => (
              <option value={s} selected={i === 0}>{s}</option>
            ))}
          </select>
        </label>

        <label>
          <span>Âge</span>
          <select id="age">
            {listeAge.map((a, i) => (
              <option value={a} selected={i === 0}>{a}</option>
            ))}
          </select>
        </label>
      </div>
    </section>

    <section class="map-panel" aria-labelledby="map-title">
      <div class="map-heading">
        <div>
          <p class="eyebrow">CARTE INTERACTIVE</p>
          <h2 id="map-title">Une France, plusieurs réalités</h2>
        </div>
        <p id="map-status" role="status" aria-live="polite">
          Préparation de la carte…
        </p>
      </div>

      <div id="map" aria-label="Carte des départements français selon la population sélectionnée"></div>

      <p class="note">
        Survolez un département pour consulter sa population. Les zones sans
        données pour la sélection actuelle ne disposent pas de valeur affichée.
      </p>
    </section>
  </main>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import populationMain from "../assets/populationMain.json";
  import departements from "../assets/departements.geojson.json";

  const elmYear = document.getElementById("periode") as HTMLSelectElement;
  const elmSex = document.getElementById("sexe") as HTMLSelectElement;
  const elmAge = document.getElementById("age") as HTMLSelectElement;
  const mapElement = document.getElementById("map") as HTMLDivElement;
  const statusElement = document.getElementById("map-status") as HTMLParagraphElement;

  function afficherCarte() {
    const selectedYear = Number(elmYear.value);
    const selectedSex = elmSex.value;
    const selectedAge = elmAge.value;

    const filteredData = populationMain.filter((d) =>
      d["Niveau Géo"] === "Département" &&
      d["Mesure du recensement "].trim() === "Population" &&
      d["Catégorie de population"] === "Total" &&
      d["Statut d'emploi variable selon l'enquête"] === "Total" &&
      d["Statut conjugal"] === "Total" &&
      Number(d.Période) === selectedYear &&
      d.Sexe === selectedSex &&
      d["Âge"].trim() === selectedAge
    );

    const populationParDepartement = new Map(
      filteredData.map((d) => [d.Géographie, d.Valeur])
    );

    const nombreAvecDonnees = departements.features.filter(
      (feature) => populationParDepartement.has(feature.properties.nom)
    ).length;

    const plot = Plot.plot({
      width: Math.max(320, Math.min(mapElement.clientWidth, 1100)),
      height: Math.max(400, Math.min(mapElement.clientWidth * 0.68, 700)),
      margin: 10,
      color: {
        type: "quantile",
        n: 8,
        scheme: "Greens",
        label: "Population en centaines de milliers",
        legend: true,
        transform: (d: number) => Math.round(d / 100000)
      },
      projection: {
        type: "mercator",
        domain: departements
      },
      title: "Population par département",
      subtitle: `Période : ${selectedYear} · Sexe : ${selectedSex} · Âge : ${selectedAge}`,
      caption: "Source : données de population fournies pour le TP7.",
      ariaLabel: "Carte choroplèthe de la population des départements français",
      marks: [
        Plot.geo(departements.features, {
          fill: (d: any) => populationParDepartement.get(d.properties.nom),
          stroke: "#ffffff",
          strokeWidth: 0.7,
          title: (d: any) => {
            const value = populationParDepartement.get(d.properties.nom);
            return value === undefined
              ? `${d.properties.nom} : données indisponibles`
              : `${d.properties.nom} : ${Number(value).toLocaleString("fr-FR")} habitants`;
          },
          tip: true
        }),
        Plot.frame()
      ]
    });

    mapElement.replaceChildren(plot);
    statusElement.textContent =
      `${nombreAvecDonnees} départements avec données · ${selectedYear} · ${selectedSex} · ${selectedAge}`;
  }

  elmYear.addEventListener("change", afficherCarte);
  elmSex.addEventListener("change", afficherCarte);
  elmAge.addEventListener("change", afficherCarte);

  afficherCarte();
</script>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 28px 80px;
    color: var(--color-base-content, #17251d);
  }

  .intro {
    max-width: 760px;
    margin-bottom: 36px;
  }

  .eyebrow {
    margin: 0 0 12px;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.15em;
    color: #43835a;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .description {
    max-width: 620px;
    margin-top: 20px;
    color: #68756c;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .panel,
  .map-panel {
    padding: 26px;
    border: 1px solid #e2e9e2;
    border-radius: 18px;
    background: #ffffff;
  }

  .panel {
    margin-bottom: 24px;
  }

  h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }

  .filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 22px;
  }

  .filters label {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 0.88rem;
    font-weight: 650;
  }

  select {
    width: 100%;
    min-height: 46px;
    padding: 0 12px;
    border: 1px solid #dce4dc;
    border-radius: 9px;
    background: #fbfcfa;
    color: #17251d;
    font: inherit;
  }

  select:focus-visible {
    outline: 2px solid #43835a;
    outline-offset: 3px;
  }

  .map-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  #map-status {
    margin: 0;
    color: #68756c;
    font-size: 0.8rem;
    text-align: right;
  }

  #map {
    width: 100%;
    min-height: 400px;
    overflow: hidden;
  }

  #map :global(svg) {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .note {
    margin: 16px 0 0;
    color: #68756c;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .page {
      padding: 36px 16px 52px;
    }

    .panel,
    .map-panel {
      padding: 18px;
      border-radius: 13px;
    }

    .filters {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .map-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    #map-status {
      text-align: left;
    }
  }
</style>
