---
import * as Plot from "@observablehq/plot";
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import populationMain from "../assets/populationMain.json";
import departements from "../assets/departements.geojson.json";

const selectedYear = 2015;
const selectedSex = "Total";
const selectedAge = "Total";

const donnees = populationMain.filter((d) =>
  d["Niveau Géo"] === "Département" &&
  d["Mesure du recensement "].trim() === "Population" &&
  d["Catégorie de population"] === "Total" &&
  d["Statut d'emploi variable selon l'enquête"] === "Total" &&
  d["Statut conjugal"] === "Total" &&
  Number(d.Période) === selectedYear &&
  d.Sexe === selectedSex &&
  d["Âge"].trim() === selectedAge
);

const populationParDepartement = new Map(
  donnees.map((d) => [d.Géographie, d.Valeur])
);

const nombreAvecDonnees = departements.features.filter(
  (feature) => populationParDepartement.has(feature.properties.nom)
).length;

const options = {
  width: 1000,
  height: 650,
  margin: 10,
  projection: {
    type: "mercator",
    domain: departements
  },
  color: {
    type: "quantile",
    n: 8,
    scheme: "Greens",
    label: "Population en centaines de milliers",
    legend: true,
    transform: (d) => Math.round(d / 100000)
  },
  title: "Population par département",
  subtitle: `Période : ${selectedYear} · Sexe : ${selectedSex} · Âge : ${selectedAge}`,
  caption: "Source : données fournies pour le TP7.",
  ariaLabel: "Carte de la population par département français",
  marks: [
    Plot.geo(departements, {
      fill: (d) => populationParDepartement.get(d.properties.nom),
      stroke: "#ffffff",
      strokeWidth: 0.7,
      title: (d) => {
        const value = populationParDepartement.get(d.properties.nom);
        return value === undefined
          ? `${d.properties.nom} : données indisponibles`
          : `${d.properties.nom} : ${Number(value).toLocaleString("fr-FR")} habitants`;
      },
      tip: true
    }),
    Plot.frame()
  ]
};
---

<Layout title="Population par département">
  <main class="page">
    <header>
      <p class="eyebrow">DONNÉES · TERRITOIRE</p>
      <h1>La population française</h1>
      <p class="description">
        Découvrez la répartition de la population française par département.
        Cette carte présente les données de 2015 pour l'ensemble de la population.
      </p>
    </header>

    <section class="map-panel" aria-labelledby="map-title">
      <div class="map-heading">
        <div>
          <p class="eyebrow">VISUALISATION STATIQUE</p>
          <h2 id="map-title">Une France, plusieurs réalités</h2>
        </div>
        <p class="status">{nombreAvecDonnees} départements avec données</p>
      </div>

      <figure>
        <PlotFigure options={options} />
        <figcaption>
          Carte choroplèthe : les nuances de vert représentent les niveaux de population.
          Survolez un département pour consulter sa valeur.
        </figcaption>
      </figure>
    </section>
  </main>
</Layout>

<style>
  .page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 28px 80px;
    color: var(--color-base-content, #17251d);
  }

  header {
    max-width: 760px;
    margin-bottom: 36px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: #43835a;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.15em;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .description {
    margin-top: 20px;
    color: #68756c;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .map-panel {
    padding: 26px;
    border: 1px solid #e2e9e2;
    border-radius: 18px;
    background: #ffffff;
  }

  .map-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.025em;
  }

  .status,
  figcaption {
    color: #68756c;
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .status {
    margin: 0;
    text-align: right;
  }

  figure {
    margin: 0;
    overflow-x: auto;
  }

  figcaption {
    margin-top: 12px;
  }

  @media (max-width: 700px) {
    .page {
      padding: 36px 16px 52px;
    }

    .map-panel {
      padding: 18px;
      border-radius: 13px;
    }

    .map-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .status {
      text-align: left;
    }
  }
</style>
