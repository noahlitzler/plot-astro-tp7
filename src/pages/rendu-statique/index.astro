---
import penguins from "../../data/penguins.json";
import cars from "../../data/cars.json";
import diamonds from "../../data/diamonds.json";
import Layout from "../../layouts/Layout.astro";

const species = [
  ...new Set(penguins.map((penguin) => penguin.species)),
];

const years = [
  ...new Set(cars.map((car) => car.year)),
].sort((a, b) => a - b);

const cuts = [
  ...new Set(diamonds.map((diamond) => diamond.cut)),
];
---

<Layout title="Rendu statique" active="statique">
  <main class="page">

    <header class="page-header">

      <div class="header-meta">
        <span>05 · ROUTE</span>
        <span>RENDU STATIQUE</span>
      </div>

      <div class="title-row">

        <div>
          <p class="category">ASTRO · GÉNÉRATION STATIQUE</p>

          <h1>
            Rendu
            <br />
            statique
          </h1>
        </div>

        <p class="description">
          Les pages sont générées à l'avance à partir
          des paramètres définis dans le projet.
        </p>

      </div>

    </header>


    <section class="dataset-section">

      <div class="section-heading">
        <span>01</span>
        <h2>Penguins</h2>
      </div>

      <p class="section-description">
        Une page statique pour chaque espèce de manchot.
      </p>

      <div class="links">

        {species.map((specie) => (
          <a
            href={`/rendu-statique/${specie}/`}
            class="route-link"
          >
            <span>{specie}</span>
            <span class="arrow">↗</span>
          </a>
        ))}

      </div>

    </section>


    <section class="dataset-section">

      <div class="section-heading">
        <span>02</span>
        <h2>Cars</h2>
      </div>

      <p class="section-description">
        Une page statique pour chaque année présente dans le dataset.
      </p>

      <div class="links">

        {years.map((year) => (
          <a
            href={`/rendu-statique/cars/${year}/`}
            class="route-link"
          >
            <span>{year}</span>
            <span class="arrow">↗</span>
          </a>
        ))}

      </div>

    </section>


    <section class="dataset-section">

      <div class="section-heading">
        <span>03</span>
        <h2>Diamonds</h2>
      </div>

      <p class="section-description">
        Une page statique pour chaque niveau de coupe du dataset.
      </p>

      <div class="links">

        {cuts.map((cut) => (
          <a
            href={`/rendu-statique/diamonds/${cut}/`}
            class="route-link"
          >
            <span>{cut}</span>
            <span class="arrow">↗</span>
          </a>
        ))}

      </div>

    </section>

  </main>
</Layout>


<style>

  .page {
    margin-left: 228px;
    padding: 0 55px 100px;
    box-sizing: border-box;
  }

  .page-header {
    padding: 45px 10px 75px;
    border-bottom: 1px solid #dedede;
  }

  .header-meta {
    display: flex;
    justify-content: space-between;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 60px;
    margin-top: 90px;
  }

  .category {
    margin: 0 0 15px;
    color: #888;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    color: #111;
    font-size: clamp(60px, 7vw, 105px);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.86;
  }

  .description {
    max-width: 350px;
    margin: 0;
    color: #666;
    font-size: 14px;
    line-height: 1.65;
  }

  .dataset-section {
    padding: 75px 10px 0;
  }

  .section-heading {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 12px;
  }

  .section-heading > span {
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .section-heading h2 {
    margin: 0;
    color: #111;
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .section-description {
    margin: 0 0 25px 35px;
    color: #777;
    font-size: 13px;
    line-height: 1.5;
  }

  .links {
    margin-left: 35px;
    border-top: 1px solid #dedede;
  }

  .route-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 65px;
    padding: 0 15px;
    border-bottom: 1px solid #dedede;
    color: #111;
    text-decoration: none;
    font-size: 14px;
    transition:
      padding 180ms ease,
      background 180ms ease;
  }

  .route-link:hover {
    padding-left: 25px;
    padding-right: 25px;
    background: #f5f5f3;
  }

  .arrow {
    color: #777;
    font-size: 18px;
  }

  @media (max-width: 900px) {

    .page {
      margin-left: 0;
      padding: 0 30px 70px;
    }

    .title-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 30px;
      margin-top: 70px;
    }

  }

  @media (max-width: 600px) {

    .page {
      padding: 0 20px 60px;
    }

    .page-header,
    .dataset-section {
      padding-left: 0;
      padding-right: 0;
    }

    .section-description,
    .links {
      margin-left: 0;
    }

  }

</style>