---
import Layout from "../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
---

<Layout title="Carte des établissements" active="leaflet">
  <main class="page">
    <header class="page-header">
      <p class="category">CARTOGRAPHIE · LEAFLET.JS</p>
      <h1>Les établissements</h1>
      <p class="description">
        Explore la répartition géographique de 2 507 établissements en France.
        Clique sur un marqueur pour afficher son nom.
      </p>
    </header>

    <section class="map-section" aria-labelledby="map-title">
      <div class="map-heading">
        <h2 id="map-title">Carte interactive</h2>
        <p id="map-status" role="status" aria-live="polite">
          Chargement des établissements…
        </p>
      </div>
      <div id="map" aria-label="Carte interactive des établissements en France"></div>
      <p class="map-caption">
        Source : liste des établissements fournie dans le cours.
        Fond cartographique © OpenStreetMap.
      </p>
    </section>
  </main>
</Layout>

<script>
  import L from "leaflet";
  import listeEtablissements from "../assets/listeEtablissements.json";

  const mapElement = document.querySelector("#map") as HTMLDivElement;
  const statusElement = document.querySelector("#map-status") as HTMLParagraphElement;

  if (mapElement && !mapElement.dataset.initialized) {
    mapElement.dataset.initialized = "true";

    const map = L.map(mapElement).setView([46.6033, 1.883], 6);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    }).addTo(map);

    const markers = L.featureGroup();

    for (const etablissement of listeEtablissements) {
      const lat = Number(etablissement.lat);
      const lon = Number(etablissement.lon);

      if (
        Number.isFinite(lat) &&
        Number.isFinite(lon) &&
        lat >= -90 &&
        lat <= 90 &&
        lon >= -180 &&
        lon <= 180
      ) {
        const marker = L.circleMarker([lat, lon], {
          radius: 4,
          color: "#ffffff",
          weight: 1,
          fillColor: "#2457c5",
          fillOpacity: 0.8,
        });

        marker.bindPopup(
          `<strong>${String(etablissement.name)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;")}</strong>`
        );

        markers.addLayer(marker);
      }
    }

    markers.addTo(map);

    statusElement.textContent =
      `${markers.getLayers().length.toLocaleString("fr-FR")} établissements affichés`;

    if (markers.getLayers().length > 0) {
      map.fitBounds(markers.getBounds(), { padding: [20, 20] });
    }

    setTimeout(() => map.invalidateSize(), 100);
  }
</script>

<style>
  .page {
    margin-left: 228px;
    padding: 0 55px 80px;
    box-sizing: border-box;
    color: #111;
  }

  .page-header {
    padding: 65px 10px 55px;
    border-bottom: 1px solid #dedede;
  }

  .category {
    color: #888;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 30px 0 20px;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .description {
    max-width: 560px;
    color: #666;
    font-size: 14px;
    line-height: 1.7;
  }

  .map-section {
    padding: 45px 10px;
  }

  .map-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  h2 {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.04em;
  }

  #map-status {
    color: #666;
    font-size: 12px;
  }

  #map {
    width: 100%;
    height: 600px;
    background: #eeeeec;
    border: 1px solid #dedede;
    z-index: 0;
  }

  .map-caption {
    margin-top: 14px;
    color: #777;
    font-size: 11px;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    .page {
      margin-left: 0;
      padding: 0 30px 60px;
    }
  }

  @media (max-width: 600px) {
    .page {
      padding: 0 20px 50px;
    }

    .map-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }

    #map {
      height: 450px;
    }
  }
</style>
