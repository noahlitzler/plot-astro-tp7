<script>
  import * as Plot from "@observablehq/plot";
  import penguins from "../data/penguins.json";

  const selectSpecies =
    document.querySelector("#species") as HTMLSelectElement;

  const selectIsland =
    document.querySelector("#island") as HTMLSelectElement;

  const selectSex =
    document.querySelector("#sex") as HTMLSelectElement;

  const container =
    document.querySelector("#plot") as HTMLDivElement;

  const resultCount =
    document.querySelector("#result-count") as HTMLParagraphElement;


  function renderPlot() {

    const species = selectSpecies.value;
    const island = selectIsland.value;
    const sex = selectSex.value;

    const filteredPenguins = penguins.filter((penguin) => {
      return (
        (!species || penguin.species === species) &&
        (!island || penguin.island === island) &&
        (!sex || penguin.sex === sex)
      );
    });


    container.innerHTML = "";


    const plot = Plot.plot({
      width: Math.min(container.clientWidth, 1000),
      height: 560,

      marginLeft: 65,
      marginBottom: 55,

      title: "Comparer les espèces de manchots",
      subtitle: "Relation entre la longueur et la profondeur du culmen",
      caption: "Chaque point représente un manchot.",
      ariaLabel: "Nuage de points comparant la longueur et la profondeur du culmen des manchots.",
      grid: true,

      x: {
        label: "Longueur du culmen (mm)",
      },

      y: {
        label: "Profondeur du culmen (mm)",
      },

      color: {
        legend: true,
      },

      marks: [
        Plot.dot(filteredPenguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          fill: "species",
          r: 5,
          fillOpacity: 0.7,
          tip: true,
        }),
      ],
    });


    container.append(plot);

    resultCount.textContent =
      `${filteredPenguins.length} manchot${filteredPenguins.length > 1 ? "s" : ""}`;
  }


  selectSpecies.addEventListener("change", renderPlot);
  selectIsland.addEventListener("change", renderPlot);
  selectSex.addEventListener("change", renderPlot);

  renderPlot();
</script>


