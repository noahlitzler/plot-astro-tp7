---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Explorer">
  <main class="page">

    <section class="hero">
      <div class="hero-meta">
        <span>01</span>
        <span>DATA VISUALISATION</span>
      </div>

      <div class="hero-content">
        <h1>
          Explorer
          <span>les données.</span>
        </h1>

        <p>
          Une collection de visualisations interactives pour observer,
          comparer et comprendre différents jeux de données.
        </p>
      </div>

      <div class="hero-bottom">
        <span>SCROLL TO EXPLORE</span>
        <span>↓</span>
      </div>
    </section>


    <section class="datasets">

      <div class="section-intro">
        <div>
          <span class="section-number">02</span>
          <h2>Datasets</h2>
        </div>

        <p>
          Trois jeux de données, trois univers à explorer.
        </p>
      </div>


      <div class="dataset-list">

        <a href="/penguins/" class="dataset">
          <div class="dataset-index">01</div>

          <div class="dataset-main">
            <span class="dataset-category">ANIMAUX</span>
            <h3>Penguins</h3>
            <p>
              Espèces, îles et caractéristiques physiques des manchots.
            </p>
          </div>

          <div class="dataset-action">
            <span>Explorer</span>
            <span class="arrow">↗</span>
          </div>
        </a>


        <a href="/cars-exploration/" class="dataset">
          <div class="dataset-index">02</div>

          <div class="dataset-main">
            <span class="dataset-category">AUTOMOBILE</span>
            <h3>Cars</h3>
            <p>
              Poids, puissance et performances d'un ensemble de voitures.
            </p>
          </div>

          <div class="dataset-action">
            <span>Explorer</span>
            <span class="arrow">↗</span>
          </div>
        </a>


        <a href="/diamonds-exploration/" class="dataset">
          <div class="dataset-index">03</div>

          <div class="dataset-main">
            <span class="dataset-category">MINÉRAUX</span>
            <h3>Diamonds</h3>
            <p>
              Carat, qualité et prix pour observer les relations entre les données.
            </p>
          </div>

          <div class="dataset-action">
            <span>Explorer</span>
            <span class="arrow">↗</span>
          </div>
        </a>

      </div>

    </section>


    <section class="routes">

      <div class="section-intro">
        <div>
          <span class="section-number">03</span>
          <h2>Routes</h2>
        </div>

        <p>
          Deux méthodes de génération de pages avec Astro.
        </p>
      </div>


      <div class="route-grid">

        <a href="/rendu-dynamique/" class="route-card">
          <div class="route-top">
            <span>04</span>
            <span>ASTRO</span>
          </div>

          <div class="route-content">
            <h3>Rendu dynamique</h3>

            <p>
              Une page générée à partir du paramètre présent dans l'URL.
            </p>
          </div>

          <div class="route-bottom">
            <span>Découvrir</span>
            <span class="arrow">↗</span>
          </div>
        </a>


        <a href="/rendu-statique/" class="route-card">
          <div class="route-top">
            <span>05</span>
            <span>ASTRO</span>
          </div>

          <div class="route-content">
            <h3>Rendu statique</h3>

            <p>
              Plusieurs pages générées automatiquement avec getStaticPaths.
            </p>
          </div>

          <div class="route-bottom">
            <span>Découvrir</span>
            <span class="arrow">↗</span>
          </div>
        </a>

      </div>

    </section>


    <footer>
      <span>EXPLORER</span>
      <span>MMI · DATA VISUALISATION</span>
      <span>2026</span>
    </footer>

  </main>
</Layout>


<style>

  .page {
    margin-left: 228px;
    padding: 0 55px;
    box-sizing: border-box;
  }


  /* HERO */

  .hero {
    min-height: calc(100vh - 80px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 45px 10px 35px;
    box-sizing: border-box;
    border-bottom: 1px solid #dedede;
  }


  .hero-meta {
    display: flex;
    justify-content: space-between;
    color: #888;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .hero-content {
    max-width: 1000px;
  }


  .hero h1 {
    margin: 0;
    color: #111;
    font-size: clamp(72px, 9vw, 145px);
    font-weight: 700;
    letter-spacing: -0.075em;
    line-height: 0.84;
  }


  .hero h1 span {
    display: block;
    color: #777;
  }


  .hero-content p {
    max-width: 510px;
    margin: 45px 0 0;
    color: #666;
    font-size: 16px;
    line-height: 1.65;
  }


  .hero-bottom {
    display: flex;
    justify-content: space-between;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  /* SECTIONS */

  .datasets,
  .routes {
    padding: 110px 10px 0;
  }


  .section-intro {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 55px;
  }


  .section-number {
    display: block;
    margin-bottom: 12px;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .section-intro h2 {
    margin: 0;
    color: #111;
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.045em;
  }


  .section-intro > p {
    max-width: 320px;
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
  }


  /* DATASETS */

  .dataset-list {
    border-top: 1px solid #dcdcdc;
  }


  .dataset {
    display: grid;
    grid-template-columns: 70px 1fr 150px;
    gap: 35px;
    align-items: center;
    min-height: 190px;
    padding: 25px 10px;
    border-bottom: 1px solid #dcdcdc;
    color: #111;
    text-decoration: none;
    box-sizing: border-box;
    transition:
      padding 180ms ease,
      background 180ms ease;
  }


  .dataset:hover {
    padding-left: 25px;
    padding-right: 25px;
    background: #f5f5f3;
  }


  .dataset-index {
    color: #999;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }


  .dataset-main {
    max-width: 650px;
  }


  .dataset-category {
    display: block;
    margin-bottom: 12px;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .dataset h3 {
    margin: 0 0 10px;
    font-size: 38px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }


  .dataset-main p {
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.55;
  }


  .dataset-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #777;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  .arrow {
    color: #111;
    font-size: 20px;
    font-weight: 400;
    letter-spacing: 0;
  }


  /* ROUTES */

  .routes {
    padding-bottom: 100px;
  }


  .route-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }


  .route-card {
    min-height: 350px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 28px;
    background: #f3f3f1;
    color: #111;
    text-decoration: none;
    box-sizing: border-box;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }


  .route-card:hover {
    background: #e9e9e7;
    transform: translateY(-4px);
  }


  .route-top,
  .route-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .route-top {
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }


  .route-content {
    max-width: 450px;
  }


  .route-content h3 {
    margin: 0 0 15px;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }


  .route-content p {
    margin: 0;
    color: #777;
    font-size: 13px;
    line-height: 1.6;
  }


  .route-bottom {
    color: #777;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }


  /* FOOTER */

  footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding: 25px 10px 35px;
    border-top: 1px solid #dedede;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }


  footer span:nth-child(2) {
    text-align: center;
  }


  footer span:last-child {
    text-align: right;
  }


  /* RESPONSIVE */

  @media (max-width: 900px) {

    .page {
      margin-left: 0;
      padding: 0 30px;
    }

    .hero {
      min-height: 650px;
    }

    .section-intro {
      align-items: flex-start;
      flex-direction: column;
    }

    .dataset {
      grid-template-columns: 50px 1fr;
    }

    .dataset-action {
      display: none;
    }

    .route-grid {
      grid-template-columns: 1fr;
    }

  }


  @media (max-width: 600px) {

    .page {
      padding: 0 20px;
    }

    .hero {
      padding-left: 0;
      padding-right: 0;
    }

    .hero h1 {
      font-size: 64px;
    }

    .datasets,
    .routes {
      padding-left: 0;
      padding-right: 0;
    }

    .dataset {
      grid-template-columns: 35px 1fr;
      gap: 15px;
      min-height: 170px;
    }

    .dataset h3 {
      font-size: 30px;
    }

    .section-intro h2 {
      font-size: 40px;
    }

    footer {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    footer span:nth-child(2),
    footer span:last-child {
      text-align: left;
    }

  }


  @media (prefers-reduced-motion: reduce) {

    .dataset,
    .route-card {
      transition: none;
    }

  }

</style>